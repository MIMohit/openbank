# Zero Trust Open Banking Testbed — environment variables
# Copy to .env and fill in before starting

# Keycloak admin credentials (local only — never real values)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin_secret_local

# Keycloak realm/client identifiers
KC_REALM_B0=openbanking-b0
KC_REALM_FAPI2=openbanking-fapi2
KC_CLIENT_ID=zt-client
KC_CLIENT_SECRET=zt-client-secret-local

# ZT Controller
ZT_MODE=P                    # B0 | B1 | P
ZT_ENFORCE_DPOP=true
ZT_CHECK_DEVICE_BINDING=true
ZT_ENABLE_TELEMETRY=true
ZT_ENABLE_RISK_POLICY=true
ZT_ENABLE_VELOCITY=true
ZT_PROXY_PASSTHROUGH=false

# Risk thresholds
ZT_RISK_THRESHOLD_ALLOW=0.4
ZT_RISK_THRESHOLD_DENY=0.7

# OPA
OPA_URL=http://opa:8181

# Mock ADR API
MOCK_ADR_URL=http://mock-adr-api:8000
MOCK_ADR_SEED=42
MOCK_ADR_NUM_USERS=100

# Network
KEYCLOAK_URL=http://keycloak:8080

# DPoP/JWS settings
DPOP_SKEW_SECONDS=60

# Replay cache (Redis or in-memory)
JTI_CACHE_TTL_SECONDS=120

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=jsonl

# Random seed for reproducibility
GLOBAL_SEED=42
